extends SceneTree
var failures:int=0
var checks:int=0
func check(value:bool,label:String)->void:
	checks+=1
	if not value: failures+=1
	print(("PASS " if value else "FAIL ")+label)
func _initialize()->void:
	var c:=StarCampaign.new()
	CampaignSetup.create(c,14030,false,96)
	for w in c.worlds.values(): w.ai_controllers.clear()
	var p:Dictionary=c.planets.colony(0,"val")
	var hq:int=int(p["hq"])
	var next:int=-1
	for id in PlanetCampaign.neighbors(hq):
		if c.planets.eligible(c,p,int(id)): next=int(id); break
	var before:Dictionary=CampaignSave.snapshot(c)
	var invalid:Dictionary=c.issue_evolution({"t":"roads","team":0,"body":"val","path":[hq,999]})
	check(not bool(invalid.get("ok",false)) and before==CampaignSave.snapshot(c),"U01 tracé invalide sans dépense ni segment partiel")
	check(next>=0,"U01 voisin constructible disponible")
	var report:Dictionary=RoadService.preview(c,0,"val",[hq,next])
	var previous:Dictionary=c.local_resources(0,"val").duplicate(true)
	var result:Dictionary=c.issue_evolution({"t":"roads","team":0,"body":"val","path":[hq,next]})
	check(bool(result.get("ok",false)) and p["cells"].has(next),"U01 tracé prévisualisé puis construit")
	check(is_equal_approx(float(previous["wood"])-float(c.local_resources(0,"val")["wood"]),float(report["cost"]["wood"])),"U01 coût total débité une seule fois")
	var rp:Dictionary=c.planets.colony(0,"val")
	var secession:Dictionary=RevoltTransaction.apply(c,rp)
	var rebel:int=int(secession["faction"])
	c.ages[0]=10
	var other:Dictionary=c.planets.found(c,0,"aurore","colony",40)
	other["local_age"]=9
	c.worlds["aurore"].spawn_building(0,"centre",Vector2i(10,70),true)
	c.worlds["aurore"].spawn_building(0,"chantier_orbital",Vector2i(20,65),true)
	c.local_resources(0,"aurore").merge({"food":1000.0,"wood":1000.0,"ore":1000.0},true)
	c._sync_all()
	var reject:Dictionary=c.issue_evolution({"t":"diplomacy","team":0,"target":rebel,"body":"val","kind":"vote"})
	check(not bool(reject.get("ok",false)),"P10 vote refusé sans confiance ni soutien")
	var pending_before:float=float(c.local_resources(rebel,"val")["food"])
	var source:Dictionary=c.local_resources(0,"aurore")
	var food:float=float(source["food"])
	var aid:Dictionary=c.issue_evolution({"t":"diplomacy","team":0,"target":rebel,"body":"val","kind":"aid"})
	check(bool(aid.get("ok",false)) and float(source["food"])<food and float(c.local_resources(rebel,"val")["food"])==pending_before,"P10 aide réservée au départ, jamais livrée instantanément")
	var t:Dictionary=c.treaties.back()
	check(String(t.get("carrier",""))=="lancement" and float(source["ore"])<1000.0,"P10 lancement matériel réellement payé")
	var resumed:StarCampaign=CampaignSave.from_snapshot(CampaignSave.snapshot(c))
	check(resumed!=null,"S01 traité et cargaison en route sauvegardés")
	for tick in int(t["duration"]): TreatyService.step(c)
	check(bool(t["delivered"]) and float(c.local_resources(rebel,"val")["food"])==pending_before+100.0,"P10 aide livrée une seule fois après trajet")
	TreatyService.step(c)
	check(float(c.local_resources(rebel,"val")["food"])==pending_before+100.0,"P10 deuxième passage sans double livraison")
	rp["politics"]["wellbeing"]=70.0
	var agreement:Dictionary=c.issue_evolution({"t":"diplomacy","team":0,"target":rebel,"body":"val","kind":"autonomy"})
	check(bool(agreement.get("ok",false)),"P10 autonomie négociable après aide")
	for tick in 599: TreatyService.step(c)
	check(c.factions.relation(0,rebel)=="truce","P10 maintien nécessaire avant autonomie")
	TreatyService.step(c)
	check(c.factions.relation(0,rebel)=="autonomous" and c.planets.has_colony(rebel,"val") and not TreatyService.can_land(c,0,"val"),"P10 autonomie conserve gouvernement propre et accès explicites")
	rp["politics"]["trust"]=60.0
	var vote:Dictionary=c.issue_evolution({"t":"diplomacy","team":0,"target":rebel,"body":"val","kind":"vote"})
	check(bool(vote.get("ok",false)),"P10 procédure de réunification acceptée")
	var age:int=int(rp["local_age"])
	for tick in 900: TreatyService.step(c)
	check(c.planets.has_colony(0,"val") and not c.planets.has_colony(rebel,"val") and int(c.planets.colony(0,"val")["local_age"])==age,"P10 réunification différée conserve âge et infrastructure")
	check(c.planets.books_balanced(0) and c.planets.books_balanced(rebel),"P10 réserves équilibrées après réunification")
	var second:Dictionary=RevoltTransaction.apply(c,c.planets.colony(0,"val"))
	check(int(second.get("faction",-1))==rebel,"F01 identité historique de la commune conservée")
	var second_body:Dictionary=RevoltTransaction.apply(c,other)
	check(int(second_body.get("faction",-1))!=rebel and c.factions.actors().size()==4,"F01 deux sécessions ont deux factions distinctes")
	check(CampaignSave.from_snapshot(CampaignSave.snapshot(c))!=null,"S01 sauvegarde multilatérale acceptée")
	var force:=StarCampaign.new()
	CampaignSetup.create(force,14031,false,96)
	var civil:Dictionary=force.planets.colony(0,"val")
	var insurrection:Dictionary=RevoltTransaction.apply(force,civil)
	var foe:int=int(insurrection["faction"])
	var capital:Vector2=civil["politics"]["capital_pos"]
	for i in 3: force.current().spawn_unit(0,"lancier",capital+Vector2(5+i,0))
	var siege:Dictionary=force.issue_evolution({"t":"diplomacy","team":0,"target":foe,"body":"val","kind":"occupation"})
	check(bool(siege.get("ok",false)),"P09 reconquête terrestre autorisée avec garnison près de la capitale")
	for tick in 299: TreatyService.step(force)
	check(force.planets.has_colony(foe,"val"),"P09 contrôle maintenu avant transfert de souveraineté")
	TreatyService.step(force)
	check(force.planets.has_colony(0,"val") and String(force.planets.colony(0,"val")["politics"]["stage"])=="occupation","P09 reconquête ouvre une occupation, sans remise à zéro")
	print("EVOLUTION_DIPLOMACY_RESULT checks=",checks," failures=",failures)
	quit(0 if failures==0 else 1)
